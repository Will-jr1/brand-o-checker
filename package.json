{
  "name": "brand-o-checker",
  "private": true,
  "version": "0.4.0",
  "engines": { "node": ">=20" },
  "description": "MVP de auditoria de marca: extrai cores de uma peça via Canvas (Delta-E + WCAG) e cruza com regras de um brandbook em JSON.",
